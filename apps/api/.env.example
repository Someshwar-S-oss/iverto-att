# Iverto Attendance API — copy to .env (§18)

PORT=8040
NODE_ENV=development
# The proxy strips the public /att prefix; the app serves /v1.
API_PREFIX=v1
# all | api | edge — only "all" exists today (§2.3)
APP_ROLE=all

# Supavisor transaction pooler (6543) for the app — connect as a role WITHOUT BYPASSRLS.
DATABASE_URL="postgres://app_user.REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session port (5432) as a migration role WITH BYPASSRLS: prisma migrate + post-init SQL.
DIRECT_URL="postgres://postgres.REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DB_POOL_MAX=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

SUPABASE_URL="https://REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_SERVICE_ROLE_KEY"
SUPABASE_JWKS_URL="https://REF.supabase.co/auth/v1/.well-known/jwks.json"

CORS_ORIGIN="https://att.iverto.ai"

# Private buckets; downloads via 5-minute signed URLs.
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_PUNCH_PHOTOS=punch-photos

# Socket.IO path the app receives (clients connect to /att/socket.io through the proxy).
WS_PATH=/socket.io
# Path the APP receives for terminals (device menu: wss://<host>/att/m50). See m50-terminal-integration.md.
M50_WS_PATH=/m50
# Optional second factor checked at Register.
M50_CLOUD_ID=

# Optional: FCM push; without it pushes are only logged (inbox still works). base64 of the service-account JSON.
FIREBASE_SERVICE_ACCOUNT=

# Set to true on replicas that must not register the repeatable jobs.
DISABLE_CRON=false
